# ============================================================
# agent-stack v2 · 环境变量模板
# 用法：cp .env.example .env  然后填写真实值
# ============================================================
#
# ⚠️ 本项目只认这一个 .env（项目根目录）。
#    agent-lite 和 go-gateway 两个服务共用它（docker-compose 的 env_file）。
#    v1 曾因为 "根目录 .env.example 少了一个 API_KEY" 导致容器部署时鉴权静默失效。
# ============================================================


# ------------------------------------------------------------
# 模型供应商
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名 —— 见 docs/2-产品规格.md 阶段一 P0 1.3
# 业务代码中禁止硬编码模型名，一律读这个变量
# opencode 可用的 DeepSeek 模型：deepseek-v4-pro / deepseek-flash
MODEL_NAME=deepseek-v4-pro


# ------------------------------------------------------------
# 服务自身鉴权（⚠️ 与上面的 OPENAI_API_KEY 是两回事）
# 客户端需带：Authorization: Bearer <API_KEY>
# 留空 = 不启用鉴权（仅限本地开发）
# 容器部署必须设置，否则鉴权失效 —— 见 docs/2-产品规格.md 阶段一 P0 1.1
# ------------------------------------------------------------
API_KEY=


# ------------------------------------------------------------
# MCP 远程服务器（可选，不需要时注释掉）
# ------------------------------------------------------------
MCP_FINANCE_URL=http://106.14.205.176:3101/sse
MCP_WEBSITE_URL=https://mcp.boce.com/sse


# ------------------------------------------------------------
# 服务端口
# ------------------------------------------------------------
AGENT_LITE_PORT=8000
GATEWAY_PORT=3000
