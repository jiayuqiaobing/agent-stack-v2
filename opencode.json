{
  "$schema": "https://opencode.ai/config.json",

  "model": "cheapai/grok-4.7",
  "small_model": "cheapai/grok-4.6",

  "provider": {
    "cheapai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CheapAI",
      "options": {
        "baseURL": "https://cheapai.info/v1",
        "apiKey": "{file:./.cheapai_key}"
      },
      "models": {
        "grok-4.7": {
          "name": "Grok 4.7 (cheapai)",
          "limit": { "context": 500000, "output": 64000 }
        },
        "grok-4.6": {
          "name": "Grok 4.6 (cheapai)",
          "limit": { "context": 500000, "output": 64000 }
        },
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash (cheapai)",
          "limit": { "context": 128000, "output": 32000 }
        }
      }
    }
  },

  "subagent_depth": 0,
  "snapshot": false,
  "autoupdate": false
}
