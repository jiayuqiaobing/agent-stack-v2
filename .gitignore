# ============================================================
# 密钥 —— 全部禁止入库
# ============================================================
.env
.env.local
agent-lite/.env
*.key
*.pem

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# ============================================================
# 运行时数据 —— 不入库
# ============================================================
# ⚠️ 注意：gitignore 不支持「行尾注释」—— 写成 `logs/   # 说明` 会把注释
#    当成模式的一部分，导致该行完全不生效（本项目踩过这个坑）。
#    注释必须独占一行。
logs/
agent-lite/logs/
chroma_db/
agent-lite/chroma_db/
agent-lite/data/
# eval/results/ 下：只保留基线，其余（每次运行的历史）不入库
#
# ⚠️ 这里有个 gitignore 的坑：**不能写成 `eval/results/` + `!baseline.json`** ——
#    排除整个目录后，git 根本不会进入该目录，目录内的 `!` 放行规则无法生效。
#    正确做法是先放行目录、再排除目录内的内容，最后对目标文件放行。
eval/results/*
!eval/results/baseline.json

# ============================================================
# ⚠️ 刻意不忽略：agent-lite/models/
# 本地 embedding 模型（BAAI/bge-small-zh-v1.5，fastembed）
# 入库以保证 Docker 部署时不依赖网络下载
# ============================================================

# ============================================================
# Go
# ============================================================
go-gateway/*.exe
go-gateway/go.sum.lock

# ============================================================
# IDE / 系统
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db

# ============================================================
# 临时文件
# ============================================================
*.tmp
*.bak
*~
.cheapai_key
